# Private login credentials. Use a long random SESSION_SECRET.
APP_USERNAME=bella
APP_PASSWORD=replace-with-a-strong-password
SESSION_SECRET=replace-with-a-long-random-secret

# Google AI Studio / Gemini API key.
GEMINI_API_KEY=
# Stable Gemini 2.5 Flash Image model code.
GEMINI_API_VERSION=v1
GEMINI_MODEL=gemini-2.5-flash-image

# Replicate API token and model slugs.
REPLICATE_API_TOKEN=
REPLICATE_REAL_ESRGAN_MODEL=nightmareai/real-esrgan
# Receives img2img plus up to 3 named control images.
REPLICATE_CONTROLNET_MODEL=lucataco/sdxl-lightning-multi-controlnet

# VPS settings.
DATA_DIR=/app/data
PORT=3000
COOKIE_SECURE=true
MAX_STORAGE_GB=10
MAX_AGE_DAYS=40
MAX_IMAGE_MB=8